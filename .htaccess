# =====================================================================
# С-АСА КОНСАЛТИНГ (s-asa.com.ua) — Конфігурація сервера Apache
# =====================================================================

# Вимкнення відображення вмісту каталогів та підпису сервера
Options -Indexes
ServerSignature Off

# Кодування за замовчуванням та головний індексний файл
AddDefaultCharset UTF-8
DirectoryIndex index.html

# Кастомна сторінка помилки 404
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# 1. КОРЕКТНІ MIME-ТИПИ (ДЛЯ PWA ТА СУЧАСНИХ ФОРМАТІВ)
# ---------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

# ---------------------------------------------------------------------
# 2. SEO-РЕДИРЕКТИ: HTTPS, БЕЗ WWW ТА БЕЗ /index.html
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Редирект з www на без www та примусовий HTTPS за один крок
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://s-asa.com.ua%{REQUEST_URI} [L,R=301]

    # Прибирання /index.html в кінці URL для уникнення дублів головної сторінки
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ https://s-asa.com.ua/ [L,R=301]
</IfModule>

# ---------------------------------------------------------------------
# 3. СТИСНЕННЯ ТРАФІКУ (GZIP / DEFLATE)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/manifest+json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ---------------------------------------------------------------------
# 4. ПРАВИЛА КЕШУВАННЯ (CACHE-CONTROL & EXPIRES)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML, маніфест та Service Worker завжди перевіряються на оновлення
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # Медіафайли та іконки кешуються на 1 рік
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Заборона жорсткого кешування Service Worker та службових файлів (включно з 404.html)
    <FilesMatch "^(sw\.js|site\.webmanifest|index\.html|404\.html|sitemap\.xml|robots\.txt)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Довгострокове кешування графіки (LOGO.png, bas-service.jpg)
    <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # -----------------------------------------------------------------
    # 5. ЗАГОЛОВКИ БЕЗПЕКИ (SECURITY HEADERS)
    # -----------------------------------------------------------------
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# Захист службових файлів (починаються з крапки, як-от .htaccess) від прямого доступу
<FilesMatch "^\.">
    Require all denied
</FilesMatch>